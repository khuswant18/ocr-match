# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_random_string

# ── Database ─────────────────────────────────────────────────────────────────
# Docker mode:  host=mysql
# Local mode:   host=127.0.0.1
SQLALCHEMY_DATABASE_URI=mysql+mysqlconnector://root:root@mysql:3306/invoice_db

# ── Groq LLM ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ── Qdrant ────────────────────────────────────────────────────────────────────
# Docker mode:  qdrant
# Local mode:   localhost
QDRANT_HOST=qdrant
QDRANT_PORT=6333
