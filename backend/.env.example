SECRET_KEY=change_me_to_a_random_string
SQLALCHEMY_DATABASE_URI=mysql+mysqlconnector://root:root@mysql:3306/invoice_db
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ── Invoice quality assessment ──
# Master switch; false restores pre-gate behaviour exactly.
QUALITY_GATE_ENABLED=true
# Hold async pipeline jobs too (false = assess + log only).
QUALITY_GATE_PIPELINE_ENABLED=true
# Shadow mode: score and log, never hold. Use to tune before arming.
QUALITY_LOG_ONLY=false
# Tier boundaries: >=HIGH proceeds, LOW..HIGH proceeds with caution, <LOW holds.
QUALITY_SCORE_HIGH=85
QUALITY_SCORE_LOW=70
# Hold cache bounds.
QUALITY_HOLD_TTL_SECONDS=1800
QUALITY_HOLD_MAX_ENTRIES=20
QUALITY_HOLD_MAX_MB=256
# Analysis probe size; metric cut-points are calibrated to this.
QUALITY_PROBE_MAX_DIM=1600
QUALITY_MAX_PAGES=5
# Set to a random string to let the batch harness skip the hold.
QUALITY_BYPASS_TOKEN=
